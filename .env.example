# ============================================================
# Pipeman sandbox configuration
# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
# ============================================================

# --- GCP project ---
GCP_PROJECT_ID=your-sandbox-project-id
GCP_REGION=us-central1

# --- Vertex AI models ---
# Rewriter/classifier tier (cheapest, fastest)
MODEL_CLASSIFIER=gemini-2.5-flash-lite
# Simple-lookup and analytics-formatting tier
MODEL_SIMPLE=gemini-2.5-flash
# Complex/multi-document reasoning tier
MODEL_COMPLEX=gemini-2.5-pro
# Embedding model
MODEL_EMBEDDING=text-embedding-005
EMBEDDING_DIMENSIONS=768

# --- Cloud SQL for PostgreSQL (pgvector) ---
# Sandbox default: pgvector inside Cloud SQL. This keeps personal-account
# cost low. Swap to Vertex AI Vector Search (see guide, Section 6) for the
# enterprise deployment without changing the API contract.
CLOUDSQL_INSTANCE_CONNECTION_NAME=your-project:your-region:pipeman-db
CLOUDSQL_DB_NAME=pipeman
CLOUDSQL_DB_USER=pipeman_app
CLOUDSQL_DB_PASSWORD=change-me-use-secret-manager-in-prod

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=8
RETRIEVAL_RERANK_TOP_N=4
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.55

# --- Vector backend switch ---
# "pgvector" (sandbox default) or "vertex_vector_search" (enterprise)
VECTOR_BACKEND=pgvector

# --- Only required if VECTOR_BACKEND=vertex_vector_search ---
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_ENDPOINT_ID=
VECTOR_SEARCH_DEPLOYED_INDEX_ID=

# --- CORS (for the local test frontend) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
